<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cold checks for the path and key logic in AS2.ModApi. Anything that does not truly need the game
    running should not need a launch to verify.

    Three things about this project are deliberate.

    It compiles the real source files rather than referencing the built DLL. AS2.ModApi is net35 and
    binds to BepInEx, Unity and LuaInterface, none of which load outside the game. Reflecting over
    the shipped assembly was tried and dies resolving MonoMod and UnityEngine. Linking the sources
    means these checks exercise the text that ships, so they cannot drift from it.

    No NuGet dependency, matching the rest of the repo. That includes the test framework: this is a
    console app returning a non-zero exit code on failure, which dotnet run reports and any CI
    understands. A test runner would be nicer and is not worth an offline-build exception.

    No game installed. Only the two genuinely external statics are faked (see Shims.cs), so unlike
    everything else here this builds and runs anywhere. That is the point, since the logic under
    test is what rejects path traversal out of untrusted keys.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>AS2.ModApi.Tests</AssemblyName>
    <RootNamespace>AS2.ModApi.Tests</RootNamespace>
    <!-- The linked sources are net35-era and use no XML doc IDs this project resolves. -->
    <NoWarn>$(NoWarn);1591;0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The production code under test. The files that carry the logic and nothing more: each one
      added here must not reach for BepInEx or Unity. That constraint is why Str and SelectorKind
      live in their own files rather than inside ModApiPlugin and AS2Events.
    -->
    <Compile Include="..\..\src\AS2.ModApi\TargetResolver.cs" Link="Production\TargetResolver.cs" />
    <Compile Include="..\..\src\AS2.ModApi\PathGuard.cs"      Link="Production\PathGuard.cs" />
    <Compile Include="..\..\src\AS2.ModApi\Str.cs"            Link="Production\Str.cs" />
    <Compile Include="..\..\src\AS2.ModApi\SelectorKind.cs"   Link="Production\SelectorKind.cs" />
    <!--
      The closed set of game broadcasts and their arities. The reason MessageTable.cs holds no
      Unity, BepInEx or game reference: a wrong arity corrupts the game's shared event table and
      breaks its own listeners, so it has to be checkable without a launch. See SurfaceChecks.cs.
    -->
    <Compile Include="..\..\src\AS2.ModApi\MessageTable.cs"   Link="Production\MessageTable.cs" />
    <!-- Atomic writes and quarantine. Pure file work, so it needs no game to exercise. -->
    <Compile Include="..\..\src\AS2.ModApi\AS2Store.cs"       Link="Production\AS2Store.cs" />
    <!--
      Whose turn the one shared scroll view is. AS2Ui is IMGUI end to end and can never compile
      here, so the rules deciding what one mod's unclosed view costs every other mod sit in their
      own file. Same split as Str and SelectorKind above. See #38 and ScrollChecks.cs.
    -->
    <Compile Include="..\..\src\AS2.ModApi\ScrollTurns.cs"    Link="Production\ScrollTurns.cs" />

    <!--
      The two concurrency fixes that shipped as bugs first, and the patch registration behind them.

      These three reference the game, so Shims.cs stands in for what they touch: an empty
      LuaInterface.Lua, the game statics AS2Events.CurrentKey reads, and enough of Harmony for
      Patches to run its by-name lookups. That buys regression cover for #16 and #26, which are
      locking bugs no reader can check by looking and no launch reliably reproduces.

      The shims copy the shape of the game's members, not the game's assembly, so they cannot catch
      a member the community patch renames. The real build of AS2.ModApi compiles against the
      shipped Assembly-CSharp and is what fails then. See the note at the top of Shims.cs.
    -->
    <Compile Include="..\..\src\AS2.ModApi\ModMenuRegistry.cs" Link="Production\ModMenuRegistry.cs" />
    <Compile Include="..\..\src\AS2.ModApi\AS2Events.cs"       Link="Production\AS2Events.cs" />
    <Compile Include="..\..\src\AS2.ModApi\Patches.cs"         Link="Production\Patches.cs" />

    <!--
      The game's bus, and the two files that hold the locks around it. MessengerBridge decides once
      per message whether this call is the one that subscribes; AS2GameEvents guards every += and -=
      with a Gate and hands each raise a snapshot of the handler list.

      Neither has ever shipped a bug, which is why they are here. They are the same shape as the two
      above that did, the locking reads as style to anybody who has not been bitten by it, and a
      racing check is the only reader that can tell a lock from decoration. See #46 and
      ConcurrencyChecks.cs.

      These reach the game harder than anything above: the four Messenger classes, Song and Vector3.
      Shims.cs stands in for all of them. ScorecardReader, RideResult and SongInfo come along because
      the bridge hands a scorecard to the event, and all three are field reads and value copies with
      no Unity in them.
    -->
    <Compile Include="..\..\src\AS2.ModApi\MessengerBridge.cs" Link="Production\MessengerBridge.cs" />
    <Compile Include="..\..\src\AS2.ModApi\AS2GameEvents.cs"   Link="Production\AS2GameEvents.cs" />
    <Compile Include="..\..\src\AS2.ModApi\ScorecardReader.cs" Link="Production\ScorecardReader.cs" />
    <Compile Include="..\..\src\AS2.ModApi\RideResult.cs"      Link="Production\RideResult.cs" />
    <Compile Include="..\..\src\AS2.ModApi\SongInfo.cs"        Link="Production\SongInfo.cs" />

    <!-- The assertions and the pass/fail summary, shared with tests\AS2.Bootstrap.Tests. -->
    <Compile Include="..\Check.cs" Link="Check.cs" />
  </ItemGroup>

</Project>
