<Project>

  <!--
    Shared build configuration for every project in this repo.

    Targets the game's own runtime: Unity 2017.4.40f1, legacy Mono, .NET 3.5 API, CLR 2.0, x64.
    References resolve out of Audiosurf2_Data/Managed rather than the net35 reference-assembly
    package. That keeps the build offline and matches what the game loads exactly.

    Consequence: .NET 3.5 BCL only. No string.IsNullOrWhiteSpace, no Task, no ValueTuple.

    Override the game location:
        dotnet build -c Release -p:AudiosurfDir="D:\Steam\steamapps\common\Audiosurf 2"
  -->

  <PropertyGroup>
    <AudiosurfDir Condition="'$(AudiosurfDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Audiosurf 2</AudiosurfDir>
    <ManagedDir>$(AudiosurfDir)\Audiosurf2_Data\Managed\</ManagedDir>
    <!--
      Overridable so tools\pack.ps1 builds against the pinned BepInEx it is about to ship, not
      whatever is installed in the game folder. Without it a release build needs BepInEx already
      installed, which a clean machine does not have.
      Must end in a directory separator. References form as $(BepInExCoreDir)BepInEx.dll.
    -->
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(AudiosurfDir)\BepInEx\core\</BepInExCoreDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>

    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      MSB3644 otherwise: no .NET 3.5 targeting pack is installed, and none is wanted, because every
      reference resolves from Audiosurf2_Data/Managed.
      Pointing these two internal properties at a real directory satisfies the reference-assembly
      lookup without contributing any assembly to the compile.
    -->
    <_TargetFrameworkDirectories>$(MSBuildThisFileDirectory)</_TargetFrameworkDirectories>
    <_FullFrameworkReferenceAssemblyPaths>$(MSBuildThisFileDirectory)</_FullFrameworkReferenceAssemblyPaths>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(ManagedDir)mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(ManagedDir)System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      On .NET 3.5 this holds Action (0-arg), Action<T1,T2..>, Func<> and HashSet<T>. mscorlib
      carries only Action<T>.
      A project that uses none of them, such as AS2.Bootstrap, does not reference it in the
      emitted assembly.
    -->
    <Reference Include="System.Core">
      <HintPath>$(ManagedDir)System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
