<Project Sdk="Microsoft.NET.Sdk">

  <!--
    References nothing but mscorlib and System, inherited from Directory.Build.props.

    This assembly runs at doorstop time, before Unity has registered its internal calls. Touching a
    UnityEngine API here does not merely fail, it poisons the binding for the whole process: a
    Debug.Log call throws MissingMethodException on DebugLogHandler.Internal_Log, Mono caches the
    failed binding, and the game's own startup code dies later.

    So there is no UnityEngine reference here to reach for by accident.
  -->

  <PropertyGroup>
    <AssemblyName>AS2.Bootstrap</AssemblyName>
    <RootNamespace>AS2.Bootstrap</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\AS2ModLoader\</OutputPath>
  </PropertyGroup>

</Project>
