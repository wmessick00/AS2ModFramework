<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared API every Audiosurf 2 mod builds on. Owns the Harmony patches that turn the game's
    untyped internals into events, so no downstream mod has to re-derive them.
  -->

  <PropertyGroup>
    <AssemblyName>AS2.ModApi</AssemblyName>
    <RootNamespace>AS2.ModApi</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\plugins\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AS2Ui draws IMGUI in the game's style: GUIStyle lives here, Font in TextRendering. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LuaInterface">
      <HintPath>$(ManagedDir)LuaInterface.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
